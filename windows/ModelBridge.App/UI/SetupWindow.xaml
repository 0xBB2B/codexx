<Window x:Class="ModelBridge.UI.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ModelBridge.UI"
        Title="设置模型接入助手" Width="620" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" FontSize="13"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <StackPanel x:Name="FormPanel">
            <TextBlock Text="连接到中台" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="填写中台提供的 Base URL 和 API Key。设置完成后，Codex 的模型列表里会多出中台模型。"
                       TextWrapping="Wrap" Margin="0,8,0,20" Foreground="{StaticResource TextMutedBrush}" />
            <StackPanel x:Name="ErrorHost" />
            <Border Style="{StaticResource Card}">
                <ui:ConnectionForm x:Name="Form" />
            </Border>
            <Button x:Name="SubmitButton" Content="完成设置" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" Margin="0,20,0,0"
                    Click="SubmitClick" />
        </StackPanel>

        <StackPanel x:Name="DonePanel" Visibility="Collapsed">
            <StackPanel x:Name="DoneHost" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="稍后自己重启" Click="LaterClick" />
                <Button Content="立即重启 ChatGPT" Style="{StaticResource PrimaryButton}" 
                        Margin="12,0,0,0" Click="RestartClick" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
