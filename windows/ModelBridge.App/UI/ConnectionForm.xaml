<UserControl x:Class="ModelBridge.UI.ConnectionForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,12,0,0">
                <TextBlock Text="Base URL" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="必填" Style="{StaticResource HelpText}" Margin="4,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <Grid>
                    <TextBox x:Name="UrlBox" Height="44" Padding="12,0" VerticalContentAlignment="Center"
                             FontFamily="Consolas" FontSize="12" TextChanged="UrlChanged"
                             AutomationProperties.Name="Base URL" />
                    <TextBlock x:Name="UrlHint" Text="https://relay.example.com/v1" IsHitTestVisible="False"
                               Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" />
                </Grid>
                <TextBlock x:Name="UrlHelp" Text="以 https:// 开头的完整地址。" Style="{StaticResource HelpText}" />
                <StackPanel x:Name="UrlError" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock Text="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource DangerBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="UrlErrorText" FontSize="12" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,12,0,0">
                <TextBlock Text="API Key" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="必填" Style="{StaticResource HelpText}" Margin="4,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <PasswordBox x:Name="KeyBox" Height="44" Padding="12,0" VerticalContentAlignment="Center"
                                     FontFamily="Consolas" FontSize="12" PasswordChanged="KeyPasswordChanged"
                                     AutomationProperties.Name="API Key" />
                        <TextBox x:Name="KeyText" Height="44" Padding="12,0" VerticalContentAlignment="Center"
                                 FontFamily="Consolas" FontSize="12" TextChanged="KeyTextChanged" Visibility="Collapsed"
                                 AutomationProperties.Name="API Key" />
                    </Grid>
                    <ToggleButton x:Name="KeyToggle" Grid.Column="1" Style="{StaticResource IconToggleButton}" Margin="8,0,0,0"
                                  Content="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                  Click="KeyToggleClick" AutomationProperties.Name="显示 API Key" />
                </Grid>
                <TextBlock x:Name="KeyHelp" Text="保存在系统凭据管理器中。" Style="{StaticResource HelpText}" />
                <StackPanel x:Name="KeyError" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock Text="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource DangerBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="KeyErrorText" FontSize="12" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
