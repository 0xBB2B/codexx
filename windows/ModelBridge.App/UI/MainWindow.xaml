<Window x:Class="ModelBridge.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ModelBridge.UI"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="模型接入助手" Width="620" MinWidth="450" SizeToContent="Height"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        WindowStartupLocation="CenterScreen" FontSize="13"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisible" />
        <Style x:Key="StatusGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </Window.Resources>
    <Grid>
    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="32" Background="{StaticResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <ui:AppIcon Width="16" Height="16" VerticalAlignment="Center" />
                <TextBlock Text="模型接入助手" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource TitleButton}" Content="&#xE921;" Click="MinimizeClick" AutomationProperties.Name="最小化" />
                <Button x:Name="MaximizeButton" Style="{StaticResource TitleButton}" Content="&#xE922;" Click="MaximizeClick" AutomationProperties.Name="最大化" />
                <Button Style="{StaticResource TitleCloseButton}" Content="&#xE8BB;" Click="CloseClick" AutomationProperties.Name="关闭" />
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource StatusBar}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText" Style="{StaticResource StatusText}" FontFamily="Consolas" />
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="16,0,8,0" />
                    <TextBlock x:Name="CoreText" Style="{StaticResource StatusText}" />
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ChatGptGlyph" Style="{StaticResource StatusGlyph}" Visibility="Visible" />
                        <TextBlock Text="ChatGPT" Style="{StaticResource LabelText}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock x:Name="ChatGptValue" Style="{StaticResource ValueText}" FontSize="12" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="RelayGlyph" Style="{StaticResource StatusGlyph}" Visibility="Visible" />
                        <TextBlock x:Name="RelayLabel" Style="{StaticResource LabelText}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock x:Name="RelayValue" Style="{StaticResource ValueText}" FontSize="12" />
                        <TextBlock x:Name="RelayNote" Style="{StaticResource LabelText}" FontSize="12" FontWeight="Normal" Margin="4,0,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateText" Style="{StaticResource StatusText}" Margin="0,0,12,0" />
                    <Button x:Name="UpdateButton" Style="{StaticResource LinkButton}" Click="UpdateClick" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                <Border x:Name="Hero" CornerRadius="12" BorderThickness="1" Padding="24,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:AppIcon Width="48" Height="48" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                <TextBlock x:Name="HeroTitle" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="HeroSub" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="ForwardToggle" Grid.Column="2" Style="{StaticResource SwitchToggle}" Tag="NoLabel"
                                          VerticalAlignment="Center" AutomationProperties.Name="使用中转" Click="ForwardClick" />
                        </Grid>
                        <Grid x:Name="ModeRow" Margin="0,12,0,0" MinHeight="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="接入方式" Style="{StaticResource LabelText}" />
                                <TextBlock x:Name="AccessName" Style="{StaticResource ValueText}" Margin="8,0,0,0" />
                                <TextBlock x:Name="AccessReason" Style="{StaticResource LabelText}" Margin="4,0,0,0" />
                            </StackPanel>
                            <Button x:Name="RecheckAccessButton" Grid.Column="1" Padding="16,0" VerticalAlignment="Center" Click="RecheckAccessClick">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Spinner x:Name="AccessSpinner" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="RecheckAccessText" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="中转配置" Style="{StaticResource CardTitle}" Margin="0,0,0,20" />
                        <ScrollViewer MaxHeight="192" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="RelayList" AlternationCount="1000" AutomationProperties.Name="中转配置">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="64" Padding="0,8" BorderBrush="{StaticResource DividerBrush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderThickness" Value="0,1,0,0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="0">
                                                            <Setter Property="BorderThickness" Value="0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <Grid Margin="0,2,0,0" TextElement.FontSize="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding State}" Value="Normal">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                <Setter Property="Text" Value="&#xE73E;" />
                                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding State}" Value="Stale">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                <Setter Property="Text" Value="&#xE7BA;" />
                                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding State}" Value="NeverFetched">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                <Setter Property="Text" Value="&#xE7BA;" />
                                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <ui:Spinner Margin="0,0,4,0" VerticalAlignment="Center">
                                                                <ui:Spinner.Style>
                                                                    <Style TargetType="ui:Spinner" BasedOn="{StaticResource {x:Type ui:Spinner}}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding State}" Value="Fetching">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ui:Spinner.Style>
                                                            </ui:Spinner>
                                                            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding State}" Value="Fetching">
                                                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding State}" Value="ForwardingOff">
                                                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding BaseUrl}" FontFamily="Consolas" Foreground="{StaticResource TextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="重试" Style="{StaticResource RowButton}" Click="RetryClick"
                                                            Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisible}}" />
                                                    <Button Content="编辑" Style="{StaticResource RowButton}" Click="EditClick" IsEnabled="{Binding CanEdit}" />
                                                    <Button Content="删除" Style="{StaticResource RowButton}" Click="DeleteClick" IsEnabled="{Binding CanDelete}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button x:Name="AddRelayButton" Content="添加配置" Click="AddRelayClick" />
                            <TextBlock x:Name="RelayFootText" Style="{StaticResource HelpText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
    <Canvas x:Name="Overlay" SizeChanged="OverlaySizeChanged">
        <StackPanel x:Name="AlertHost" Canvas.Left="24" Canvas.Top="44" />
    </Canvas>
    </Grid>
</Window>
